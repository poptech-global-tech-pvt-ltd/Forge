{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["is_success", "data"],
  "properties": {
    "is_success": { "type": "boolean" },
    "message": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["addresses"],
      "properties": {
        "addresses": {
          "type": "object",
          "properties": {
            "CURRENT": {
              "type": "object",
              "properties": {
                "current_addresses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["address_type"],
                    "properties": {
                      "address_type": { "type": "string" },
                      "address_line_1": { "type": "string" },
                      "city": { "type": "string" },
                      "state": { "type": "string" },
                      "postal_code": { "type": "string" }
                    }
                  }
                },
                "is_editable": { "type": "boolean" }
              }
            },
            "OFFICE": {
              "type": "object",
              "properties": {
                "office_addresses": { "type": "array" },
                "is_editable": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
