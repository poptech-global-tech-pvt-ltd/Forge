{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["is_success", "data"],
  "properties": {
    "is_success": { "type": "boolean" },
    "data": {
      "type": "object",
      "required": ["last_saved_level"],
      "properties": {
        "last_saved_level": { "type": "string", "minLength": 1 }
      }
    }
  }
}
