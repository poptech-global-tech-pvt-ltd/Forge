<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  RCBP API Test Suite
  Run: mvn test -DsuiteXmlFile=src/test/resources/suites/rcbp-suite.xml -Denv=sit

  Tests run sequentially (parallel=false) because each test class is a chained
  flow where later steps depend on values extracted from earlier steps.

  Credit Card Bills (10 tests):
    list billers → input fields → fetch bills → initiate payment → confirm payment

  Mobile Postpaid Bills (10 tests):
    list billers → input fields → bill fetch → initiate payment → confirm payment

  Prepaid Recharge (10 tests + 2 independent operator-circle tests):
    fetch plans → bill fetch → initiate payment → confirm payment
    + independent: fetch operator-circle
-->
<suite name="RCBP API Tests" verbose="2" parallel="false">

    <test name="Credit Card Bills">
        <groups>
            <run>
                <include name="rcbp-credit-card"/>
            </run>
        </groups>
        <classes>
            <class name="com.popclub.apiTests.rcbp.CreditCardBillsTest"/>
        </classes>
    </test>

    <test name="Mobile Postpaid Bills">
        <groups>
            <run>
                <include name="rcbp-mobile-postpaid"/>
            </run>
        </groups>
        <classes>
            <class name="com.popclub.apiTests.rcbp.MobilePostpaidBillsTest"/>
        </classes>
    </test>

    <test name="Prepaid Recharge">
        <groups>
            <run>
                <include name="rcbp-recharge"/>
            </run>
        </groups>
        <classes>
            <class name="com.popclub.apiTests.rcbp.RechargeTest"/>
        </classes>
    </test>

</suite>
