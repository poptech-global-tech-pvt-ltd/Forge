<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Tuition C2C Full Suite — Android login → student API tests → tutor onboarding API tests.

  Runs in a single JVM so TestContext carries the student JWT from the YAML step
  directly into TuitionPayerJourneyTest without any extra config.

  Run:
    mvn test -Dsurefire.suiteXmlFiles=src/test/resources/suites/testng-tuition-full.xml -Denv=sit

  Override device serial:
    mvn test -Dsurefire.suiteXmlFiles=src/test/resources/suites/testng-tuition-full.xml -Denv=sit -DdeviceSerial=<serial>
-->
<suite name="Tuition C2C Full Suite" parallel="false">

    <listeners>
        <listener class-name="com.popclub.listener.TestListener"/>
    </listeners>

    <parameter name="deviceSerial" value=""/>
    <parameter name="projectId"    value="d8f4a221-bc6d-47d8-9448-0834f5d012ec"/>
    <parameter name="tag"          value="tuition-c2c"/>

    <!-- ── Step 1: Android login + captureToken ───────────────────────────
         Launches the app, logs in with the student number, captures JWT
         into TestContext.getUserToken() for the API tests below.         -->
    <test name="Step 1 — Student App Login">
        <parameter name="testFile" value="tuition_create.yaml"/>
        <classes>
            <class name="com.popclub.runner.TestRunnerTest"/>
        </classes>
    </test>

    <!-- ── Step 2: Student payer API tests (uses token from Step 1) ──────
         Stores invite_code + orderNumber in TestContext for Step 3.      -->
    <test name="Step 2 — Student Payer API (Happy Path)">
        <groups>
            <run>
                <include name="tuition-payer"/>
            </run>
        </groups>
        <classes>
            <class name="com.popclub.apiTests.tuition.TuitionPayerJourneyTest"/>
        </classes>
    </test>

    <!-- ── Step 3: Tutor onboarding API tests (uses invite_code from Step 2) -->
    <test name="Step 3 — Tutor Onboarding API (Happy Path)">
        <groups>
            <run>
                <include name="tuition-onboarding"/>
            </run>
        </groups>
        <classes>
            <class name="com.popclub.apiTests.tuition.TuitionOnboardingTest"/>
        </classes>
    </test>

    <!-- ── Step 4: Student error cases ──────────────────────────────────── -->
    <test name="Step 4 — Student Payer API (Error Cases)">
        <groups>
            <run>
                <include name="tuition-payer-error"/>
            </run>
        </groups>
        <classes>
            <class name="com.popclub.apiTests.tuition.TuitionPayerJourneyTest"/>
        </classes>
    </test>

    <!-- ── Step 5: Tutor error cases ─────────────────────────────────────── -->
    <test name="Step 5 — Tutor Onboarding API (Error Cases)">
        <groups>
            <run>
                <include name="tuition-onboarding-error"/>
            </run>
        </groups>
        <classes>
            <class name="com.popclub.apiTests.tuition.TuitionOnboardingTest"/>
        </classes>
    </test>

</suite>
