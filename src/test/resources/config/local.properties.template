# ─── Cloud / STF device farm (CloudConfig) ────────────────────────────────────
cloud.enabled=false

# STF (OpenSTF) device lab — get the URL from your team's STF instance
stf.base.url=https://<stf-ip>
stf.auth.email=testdevices@temp.popclub.co
stf.auth.name=test

# Comma-separated Appium server ports (one per parallel device)
appium.remote.ports=4723,4725,4727,4729,4731

# SET ME: path to your local Node.js binary (used to launch Appium)
appium.node.path=~/.nvm/versions/node/v20.20.1/bin/node

# SET ME: Android SDK root — leave blank to fall back to $ANDROID_HOME env var
android.home=

# Auto-grant all permission dialogs and dismiss generic dialogs between steps (forge mode)
forge.auto.grant.permissions=true
forge.auto.dismiss.dialogs=true

# ForgeDriver parallel port pool (default 7790-7799 = up to 10 concurrent devices)
# forge.port.range=7790-7799
#
# On the STF Mac, run socat for every port in the range (one-time setup):
#   for p in $(seq 7790 7799); do socat TCP-LISTEN:$p,fork,reuseaddr TCP:localhost:$p & done
# Or use the LaunchDaemon at com.popclub.forge-relay.plist in the STF repo.
