# Copy this file to local.properties and fill in your values.
# local.properties is gitignored — never commit real tokens or credentials.
#
# Setup:
#   cp src/test/resources/config/local.properties.template \
#      src/test/resources/config/local.properties

ENV=local

# Base URLs
APP_BASE_URL=https://app.popclub.co.in
HASHIRA_BASE_URL=https://hashira.popclub.co.in
USER_PROFILE_BASE_URL=https://userprofile.popclub.co.in
PROD_BASE_URL=https://prod.popclub.co.in
PRESENTATION_BASE_URL=https://presentation.popclub.co.in/api/

# Auth tokens — get from the team's internal secrets store
APP_TOKEN=
PROD_TOKEN=

# User JWT for CLP calls — grab from OkHttp logcat after login:
# look for "X-Access-Token: Bearer <token>" in device logs
USER_TOKEN=

# Device serial for CLP verification (run: adb devices)
DEVICE_SERIAL=

# TestSigma API token — get from https://arcus.testsigma.com/ui/settings/apikeys
TESTSIGMA_API_TOKEN=

# Phone number series for onboarding test accounts
PHONE_PREFIX=+91
PHONE_BASE=1234560001
PHONE_MAX=1234569999
