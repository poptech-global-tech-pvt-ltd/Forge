# ─────────────────────────────────────────────────────────────────────────────
# Cloud / device-farm override — for machines on the pop-device-farm network
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to:  src/main/resources/config/local.cloud.properties
# That file is gitignored and overrides cloud.properties defaults.
# ─────────────────────────────────────────────────────────────────────────────

cloud.enabled=true

# IP of the device farm (the Mac running pop-device-farm / start.sh)
stf.base.url=https://192.168.15.62

# Appium paths — leave blank to auto-detect from PATH, or override if needed
# appium.node.path=/opt/homebrew/bin/node
# appium.js.path=/opt/homebrew/lib/node_modules/appium/build/lib/main.js
